{
  "version": 1,
  "language": "ru",
  "note": "Original GoBot examples, not copied training data or real-user statistics. Empty patterns refer to existing router or planned integrations.",
  "sources": [
    "https://github.com/OHF-Voice/intents",
    "https://developer.amazon.com/en-US/docs/alexa/custom-skills/standard-built-in-intents.html",
    "https://support.apple.com/en-gb/HT209055"
  ],
  "entries": [
    {
      "intent": "clock_time",
      "executor": "clock",
      "status": "implemented",
      "patterns": [
        "(?:сколько|который) (?:сейчас )?(?:времени|час)",
        "какое (?:сейчас )?время",
        "(?:скажи|подскажи|назови)(?: мне)? (?:текущее )?время"
      ],
      "examples": [
        "Сколько сейчас времени?",
        "Который час?",
        "Сколько времени?",
        "Какое сейчас время?",
        "Подскажи время",
        "Назови текущее время"
      ],
      "source": "gobot_authored",
      "slot_validation": "exact_utterance",
      "priority": 0
    },
    {
      "intent": "clock_date",
      "executor": "clock",
      "status": "implemented",
      "patterns": [
        "какая (?:сегодня|сейчас) дата",
        "(?:скажи|назови) (?:сегодняшнюю|текущую) дату",
        "какое сегодня число"
      ],
      "examples": [
        "Какая сегодня дата?",
        "Какое сегодня число?",
        "Назови сегодняшнюю дату",
        "Скажи текущую дату"
      ],
      "source": "gobot_authored",
      "slot_validation": "exact_utterance",
      "priority": 0
    },
    {
      "intent": "clock_weekday",
      "executor": "clock",
      "status": "implemented",
      "patterns": [
        "какой (?:сегодня )?день недели"
      ],
      "examples": [
        "Какой сегодня день недели?",
        "Какой день недели?"
      ],
      "source": "gobot_authored",
      "slot_validation": "exact_utterance",
      "priority": 0
    },
    {
      "intent": "timer_start",
      "executor": "timer",
      "status": "implemented",
      "patterns": [
        "(?:поставь|установи|запусти|включи)(?: мне)? таймер(?: на)?(?: (?P<duration>.+))?",
        "таймер(?: на)?(?: (?P<duration>.+))?",
        "(?:засеки|отсчитай)(?: мне)? (?P<duration>.+)"
      ],
      "examples": [
        "Поставь таймер на пять минут",
        "Запусти таймер на 30 секунд",
        "Засеки три минуты",
        "Отсчитай две минуты",
        "Таймер на полчаса",
        "Поставь таймер"
      ],
      "source": "gobot_authored",
      "slot_validation": "timer_duration_parser",
      "priority": 0
    },
    {
      "intent": "timer_cancel",
      "executor": "timer",
      "status": "implemented",
      "patterns": [
        "(?:отмени|останови|выключи|убери)(?: все| мои| мой)? таймер(?:ы)?"
      ],
      "examples": [
        "Отмени таймер",
        "Останови таймер",
        "Выключи все таймеры",
        "Убери таймер"
      ],
      "source": "gobot_authored",
      "slot_validation": "timer_duration_parser",
      "priority": 0
    },
    {
      "intent": "timer_remaining",
      "executor": "timer_status",
      "status": "implemented",
      "patterns": [
        "сколько (?:времени )?осталось(?: времени)? (?:на таймере|до конца таймера)",
        "когда (?:закончится|сработает) таймер",
        "(?:покажи|назови) (?:мои )?таймеры",
        "есть (?:ли )?(?:активный|работающий) таймер"
      ],
      "examples": [
        "Сколько осталось на таймере?",
        "Сколько времени осталось на таймере?",
        "Когда закончится таймер?",
        "Покажи мои таймеры",
        "Есть активный таймер?"
