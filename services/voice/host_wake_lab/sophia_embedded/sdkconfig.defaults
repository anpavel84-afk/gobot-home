# HOST-B ONLY: sandbox with IDENTICAL offsets/sizes to read-only RC1 metadata.
# NO 'model' partition. Sophia packed image is EMBEDDED INSIDE app Flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_RC1_LAYOUT_CHECK_ONLY.csv"
CONFIG_SR_WN_WN10_SOPHIA=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192