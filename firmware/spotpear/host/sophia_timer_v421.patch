+
+void Application::HostTimerControl(const cJSON* root) {
+    auto* ws=static_cast<WebsocketProtocol*>(protocol_.get());
+    const auto session=gobot::String(root,"session_id",80);
+    const auto epoch=gobot::String(root,"epoch",80);
+    if(!host_mode_ || !host_ready_ || !ws || !ws->HostV2() || !session || !epoch ||
+       !ws->HostScope(session,epoch))return;
+    const auto revision=cJSON_GetObjectItem(root,"revision");
+    const auto remaining=cJSON_GetObjectItem(root,"remaining_ms");
+    const auto state=gobot::String(root,"state",8);
+    const auto id=cJSON_GetObjectItem(root,"timer_id");
+    if(!cJSON_IsNumber(revision) || !cJSON_IsNumber(remaining) || !cJSON_IsString(id))return;
+    const auto result=host_timer_ui_.Update(revision->valuedouble,state,id->valuestring,
+                                          remaining->valuedouble,gobot::NowMs());
+    if(result!=gobot_host::TimerUpdate::Accepted)return;
+    timer_key_=host_timer_ui_.Id();gobot_timer_end_=host_timer_ui_.Deadline();
+    timer_latched_=host_timer_ui_.Expired();
+    RenderGoBot(); // Presentation only; mute/capture/output/wake/grants stay unchanged.
+}
+
+void Application::HostTimerRendered(bool timer_visible,gobot_host::NativeRenderResult result) {
+    auto* ws=static_cast<WebsocketProtocol*>(protocol_.get());
+    if(!host_mode_ || !host_ready_ || !ws || !ws->HostV2() ||
+       !host_timer_ui_.ObserveRender(result,timer_visible))return;
+    HostControl("gobot_host_timer_ack",std::string(",\"revision\":")+
+        std::to_string(host_timer_ui_.Revision())+",\"state\":\""+host_timer_ui_.State()+
+        "\",\"timer_id\":\""+host_timer_ui_.Id()+"\",\"rendered\":"+
+        (host_timer_ui_.Rendered()?"true":"false")+",\"evidence\":\""+
+        host_timer_ui_.Evidence()+"\"");
 }
 
