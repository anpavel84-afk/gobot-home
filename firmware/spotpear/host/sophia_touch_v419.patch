diff --git a/main/host_touch_controls.inc b/main/host_touch_controls.inc
new file mode 100644
--- /dev/null
+++ b/main/host_touch_controls.inc
@@ -0,0 +1,111 @@
+// Shared production gesture dispatch; included by Application and native regression harness.
+void Application::TouchGesture(bool physical, bool hold) {
+    const uint64_t now=gobot::NowMs();
+    if (physical) ++touch_events_;
+    if (!hold && now < last_contact_+350) return;
+    last_contact_=now;
+    // Privacy is idempotent and precedes every busy/connection/interrupt guard.
+    // Release of this hold is consumed by the board gesture recognizer.
+    if(hold) {
+        host_touch_resume_pending_=false;
+        HostSetMuted(true);
+        if(!host_mode_ && gobot_turn_.Active()) {
+            if(protocol_ && protocol_->IsAudioChannelOpened())protocol_->SendAbortSpeaking(kAbortReasonNone);
+            GoBotFinish("manual_mute");
+        }
+        RenderGoBot();return;
+    }
+    if(host_mode_) {
+        auto* ws=static_cast<WebsocketProtocol*>(protocol_.get());
+        if(host_muted_ || gobot_muted_) {
+            // A physical tap explicitly restores the microphone. The fresh
+            // capture handshake must finish before the one requested listen.
+            HostSetMuted(false);host_touch_resume_pending_=!host_muted_ && !gobot_muted_;
+            RenderGoBot();return;
+        }
+        if(!host_ready_) {
+            host_touch_resume_pending_=!host_touch_resume_pending_;
+            RenderGoBot();return;
+        }
+        if(host_interrupt_.Pending()) {
+            if(host_interrupt_.Listen()) {
+                host_interrupt_.StopListening();host_touch_active_=false;gobot_ui_phase_.clear();
+                HostControl("gobot_host_touch",",\"action\":\"stop\",\"gesture\":\"tap\",\"event_id\":\""+
+                    std::string(host_interrupt_.Id())+"\",\"interrupt_requested\":true");
+            }
+            RenderGoBot();return;
+        }
+        const bool busy=host_response_busy_ || host_output_active_;
+        if(ws && ws->HostV2() && (busy || host_touch_active_)) {
+            const bool listen=busy;
+            const auto id=std::string("touch-")+std::to_string(++host_wake_sequence_);
+            if(HostBeginInterrupt(id,listen)) {
+                ++host_barge_taps_;
+                HostControl("gobot_host_touch",std::string(",\"action\":\"")+(listen?"interrupt":"stop")+
+                    "\",\"gesture\":\"tap\",\"trigger\":\"touch\",\"event_id\":\""+id+
+                    "\",\"stream_epoch\":\""+ws->HostStreamEpoch(audio_service_.HostCaptureEpoch())+
+                    "\",\"detector_sample\":"+std::to_string(audio_service_.HostCaptureSampleEnd())+HostInterruptFields());
+            }
+        } else if(busy || host_touch_active_) {
+            host_touch_active_=false;host_response_busy_=false;gobot_ui_phase_.clear();
+            HostControl("gobot_host_touch",",\"action\":\"stop\",\"gesture\":\"stop\"");
+        } else {
+            if(!host_admission_ui_.KnownBlocked()) {
+                host_touch_active_=true;host_voice_seen_=false;host_touch_started_ms_=now;
+                audio_service_.AllowHostWake(false);
+            }
+            HostControl("gobot_host_touch",",\"action\":\"activate\",\"gesture\":\"activate\"");
+        }
+        RenderGoBot();return;
+    }
+    if(gobot_raw_wake::touch(physical,false,now)){RenderGoBot();return;}
+    if(gobot_muted_ || host_muted_)HostSetMuted(false);
+    if(gobot_muted_ || host_muted_){RenderGoBot();return;}
+    const auto phase=gobot_turn_.GetPhase();
+    if(phase==gobot::Phase::Capturing) {
+        if(protocol_ && protocol_->IsAudioChannelOpened())protocol_->SendAbortSpeaking(kAbortReasonNone);
+        GoBotFinish("manual_stop");
+    } else if(phase==gobot::Phase::Idle) {
+        if(timer_latched_) {timer_latched_=false;timer_key_.clear();}
+        else StartGoBotTurn(physical?"touch":"button");
+    }
+    RenderGoBot();
+}
+
+void Application::HostSetMuted(bool muted,bool notify) {
+    // Fence already-sent host commands with a device-owned physical revision.
+    // A repeated hold is another privacy intent, even when already muted.
+    if(notify && host_mute_revision_!=UINT32_MAX)++host_mute_revision_;
+    if(host_mute_revision_==UINT32_MAX)muted=true; // never wrap into an old unmute revision
+    const auto fields=std::string(",\"muted\":")+(muted?"true":"false")+
+        ",\"mute_revision\":"+std::to_string(host_mute_revision_);
+    if(host_muted_==muted && gobot_muted_==muted) {
+        if(notify)HostControl("gobot_host_mute",fields);
+        return;
+    }
+    host_muted_=gobot_muted_=muted;
+    if(muted)host_touch_resume_pending_=false;
+    // Keep a pending quiet receipt alive; mute cancels its listening intent,
+    // not the physical cancellation proof. No capture/output is re-enabled.
+    if(muted)host_interrupt_.StopListening();
+    else host_interrupt_.Reset();
+    audio_service_.AllowHostWake(false);
+    audio_service_.EnableHostCapture(false);audio_service_.SetLocalScan(false);
+    audio_service_.EnableVoiceProcessing(false);audio_service_.ResetDecoder();
+    host_touch_active_=host_response_busy_=false;host_output_receipts_.Reset();
+    host_whole_response_=host_output_end_=false;
+    if(notify)HostControl("gobot_host_mute",fields);
+    else HostControl("gobot_host_ack",",\"event\":\"muted\""+fields);
+    if(!muted) {
+        host_admission_ui_.Reset();
+        // A new authenticated transport/capture epoch prevents old PCM or a
+        // hidden sample discontinuity from crossing mute/unmute.
+        host_ready_=false;host_output_active_=host_output_started_=host_output_end_=false;
+        host_playback_id_.clear();host_response_id_.clear();host_stop_id_.clear();
+        if(host_connecting_.load())host_connect_abort_reason_="mute_changed";
+        else if(protocol_)protocol_->CloseAudioChannel();
+        host_ready_deadline_ms_=0;host_next_retry_ms_=gobot::NowMs();audio_service_.SetLocalScan(true);
+    }
+    RenderGoBot();
+}
+
diff --git a/main/host_touch_gesture.h b/main/host_touch_gesture.h
new file mode 100644
--- /dev/null
+++ b/main/host_touch_gesture.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cstdint>
+
+namespace gobot_host {
+enum class TouchGesture { None, Tap, Hold };
+
+// One physical contact produces exactly one gesture. Privacy takes effect at
+// the hold threshold while the finger remains down, without a duration cap.
+class TouchPress {
+public:
+    TouchGesture Update(bool down,uint64_t now) {
+        if(down && !pressed_) {
+            pressed_=true;held_=false;started_=now;
+            return TouchGesture::None;
+        }
+        if(!pressed_)return TouchGesture::None;
+        if(now<started_) {pressed_=false;held_=false;return TouchGesture::None;}
+        const auto elapsed=now-started_;
+        if(down) {
+            if(!held_ && elapsed>=650) {held_=true;return TouchGesture::Hold;}
+            return TouchGesture::None;
+        }
+        pressed_=false;
+        if(held_) {held_=false;return TouchGesture::None;}
+        if(elapsed>=650)return TouchGesture::Hold;
+        return elapsed>=40?TouchGesture::Tap:TouchGesture::None;
+    }
+private:
+    bool pressed_=false,held_=false;
+    uint64_t started_=0;
+};
+}
