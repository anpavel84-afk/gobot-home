+struct AecFrameLevels {
+    uint64_t frame=0;
+    uint32_t mic_avg_abs=0,ref_avg_abs=0,clean_avg_abs=0;
+    uint32_t mic_peak=0,ref_peak=0,clean_peak=0;
+};
+
+// A single input writer publishes six PCM magnitudes, never audio samples.
+// A bounded seqlock snapshot avoids mixing levels from different AEC frames.
+class AecLevelTelemetry {
+public:
+    void Store(const AecFrameLevels& v) {
+        sequence_.fetch_add(1);
+        average_.store(Pack(v.mic_avg_abs,v.ref_avg_abs,v.clean_avg_abs));
+        peak_.store(Pack(v.mic_peak,v.ref_peak,v.clean_peak));frame_.store(v.frame);
+        sequence_.fetch_add(1);
+    }
+    AecFrameLevels Load()const {
+        for(unsigned attempt=0;attempt<3;++attempt) {
+            const auto before=sequence_.load();if(before&1)continue;
+            const auto averages=average_.load(),peaks=peak_.load(),frame=frame_.load();
+            if(before!=sequence_.load())continue;
+            return {frame,Part(averages,0),Part(averages,16),Part(averages,32),
+                Part(peaks,0),Part(peaks,16),Part(peaks,32)};
+        }
+        return {}; // bounded retry; frame=0 explicitly means unavailable
+    }
+private:
+    static uint64_t Pack(uint32_t a,uint32_t b,uint32_t c) {
+        return uint64_t(a) | (uint64_t(b)<<16) | (uint64_t(c)<<32);
+    }
+    static uint32_t Part(uint64_t value,unsigned shift){return (value>>shift)&0xffffu;}
+    std::atomic<uint32_t> sequence_{0};
+    std::atomic<uint64_t> average_{0},peak_{0},frame_{0};
+};
