diff --git a/main/host_admission_ui.h b/main/host_admission_ui.h
new file mode 100644
index 0000000..e12744a
--- /dev/null
+++ b/main/host_admission_ui.h
@@ -0,0 +1,128 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+// Fixed, volatile presentation state. This is never authority to capture,
+// spend, start a provider response, change the detector, or cancel playback.
+namespace gobot_host {
+enum class AdmissionCode : uint8_t {
+    Unknown=0, Available=1, ScopeExpired=2, StartsExhausted=3,
+    ConsentRequired=4, Unavailable=5
+};
+enum class AdmissionMode : uint8_t { Fast=0, Expert=1 };
+enum class AdmissionUpdate : uint8_t { Ignored=0, Accepted=1, Invalid=2 };
+enum class NativeRenderResult : uint8_t { Failed=0, Unchanged=1, Invalidated=2 };
+
+class AdmissionUi {
+public:
+    void Reset() {
+        Assign(false,false,AdmissionCode::Unknown,AdmissionMode::Fast);
+        rendered_notice_=false;render_result_=NativeRenderResult::Failed;native_view_=0;
+        reported_=false;
+    }
+
+    // The caller obtains scope_matches from the authenticated HostScope check.
+    // allowed_token is 0/1 only for JSON false/true, -1 for every other type.
+    AdmissionUpdate Update(bool ready_v2,bool scope_matches,int allowed_token,
+                           const char* code,const char* mode) {
+        if(!ready_v2 || !scope_matches)return AdmissionUpdate::Ignored;
+        AdmissionCode parsed_code=AdmissionCode::Unknown;
+        AdmissionMode parsed_mode=mode_;
+        const bool valid_mode=ParseMode(mode,parsed_mode);
+        const bool valid_code=ParseCode(code,parsed_code);
+        if((allowed_token!=0 && allowed_token!=1) || !valid_code || !valid_mode ||
+           ((parsed_code==AdmissionCode::Available)!=(allowed_token==1))) {
+            // Reject malformed same-scope data without changing live media.
+            // It cannot preserve an optimistic Available indication.
+            Assign(true,false,AdmissionCode::Unavailable,parsed_mode);
+            return AdmissionUpdate::Invalid;
+        }
+        Assign(true,allowed_token==1,parsed_code,parsed_mode);
+        return AdmissionUpdate::Accepted;
+    }
+
+    bool Known() const {return known_;}
+    bool InputAllowed() const {return known_ && input_allowed_;}
+    bool KnownBlocked() const {return known_ && !input_allowed_;}
+    AdmissionCode Code() const {return code_;}
+    AdmissionMode Mode() const {return mode_;}
+    uint32_t Revision() const {return revision_;}
+    bool ShouldShowNotice(bool transport_ready,bool idle,bool muted,
+                          bool priority_view) const {
+        return transport_ready && idle && !muted && !priority_view && KnownBlocked();
+    }
+    const char* CodeName() const {
+        switch(code_) {
+        case AdmissionCode::Available:return "available";
+        case AdmissionCode::ScopeExpired:return "scope_expired";
+        case AdmissionCode::StartsExhausted:return "starts_exhausted";
+        case AdmissionCode::ConsentRequired:return "consent_required";
+        case AdmissionCode::Unavailable:return "unavailable";
+        default:return "unknown";
+        }
+    }
+    const char* ModeName() const {return mode_==AdmissionMode::Expert?"expert":"fast";}
+    const char* NoticeText() const {
+        if(!KnownBlocked())return "";
+        switch(code_) {
+        case AdmissionCode::ScopeExpired:return "Время теста истекло";
+        case AdmissionCode::StartsExhausted:return "Лимит исчерпан";
+        case AdmissionCode::ConsentRequired:return "Нужно разрешение";
+        default:return "Разговор недоступен";
+        }
+    }
+    const char* NoticeDetail() const {
+        return mode_==AdmissionMode::Expert?"Экспертный режим":"Быстрый разговор";
+    }
+
+    // Called only after the real native Render() result. An invalidated buffer
+    // is not evidence of LVGL refresh, panel DMA completion or visible pixels.
+    bool ObserveRender(NativeRenderResult result,bool notice,uint8_t native_view) {
+        render_result_=result;native_view_=native_view;
+        rendered_notice_=notice && KnownBlocked() && result!=NativeRenderResult::Failed;
+        if(!known_ || result==NativeRenderResult::Failed)return false;
+        if(reported_ && reported_revision_==revision_ &&
+           reported_notice_==rendered_notice_ && reported_view_==native_view_)return false;
+        reported_=true;reported_revision_=revision_;
+        reported_notice_=rendered_notice_;reported_view_=native_view_;
+        return true;
+    }
+    bool RenderedNotice() const {return rendered_notice_;}
+    uint8_t NativeView() const {return native_view_;}
+    NativeRenderResult RenderResult() const {return render_result_;}
+    const char* RenderEvidence() const {
+        return render_result_==NativeRenderResult::Invalidated
+            ?"native_framebuffer_invalidated":"native_framebuffer_unchanged";
+    }
+
+private:
+    bool known_=false,input_allowed_=false,rendered_notice_=false;
+    bool reported_=false,reported_notice_=false;
+    AdmissionCode code_=AdmissionCode::Unknown;
+    AdmissionMode mode_=AdmissionMode::Fast;
+    NativeRenderResult render_result_=NativeRenderResult::Failed;
+    uint8_t native_view_=0,reported_view_=0;
+    uint32_t revision_=0,reported_revision_=0;
+
+    void Assign(bool known,bool allowed,AdmissionCode code,AdmissionMode mode) {
+        if(known_!=known || input_allowed_!=allowed || code_!=code || mode_!=mode)++revision_;
+        known_=known;input_allowed_=allowed;code_=code;mode_=mode;
+    }
+    static bool ParseMode(const char* value,AdmissionMode& out) {
+        if(value && !std::strcmp(value,"fast")){out=AdmissionMode::Fast;return true;}
+        if(value && !std::strcmp(value,"expert")){out=AdmissionMode::Expert;return true;}
+        return false;
+    }
+    static bool ParseCode(const char* value,AdmissionCode& out) {
+        if(!value)return false;
+        if(!std::strcmp(value,"available"))out=AdmissionCode::Available;
+        else if(!std::strcmp(value,"scope_expired"))out=AdmissionCode::ScopeExpired;
+        else if(!std::strcmp(value,"starts_exhausted"))out=AdmissionCode::StartsExhausted;
+        else if(!std::strcmp(value,"consent_required"))out=AdmissionCode::ConsentRequired;
+        else if(!std::strcmp(value,"unavailable"))out=AdmissionCode::Unavailable;
+        else return false;
+        return true;
+    }
+};
+static_assert(sizeof(AdmissionUi)<=48,"Admission UI state must stay fixed and small");
+}
