+void Application::HostAdmissionRendered(bool notice,uint8_t native_view,gobot_host::NativeRenderResult result) {
+    const bool changed=host_admission_ui_.ObserveRender(result,notice,native_view);
+    if(!changed || !host_mode_ || !host_ready_)return;
+    auto* ws=static_cast<WebsocketProtocol*>(protocol_.get());
+    if(!ws || !ws->HostV2())return;
+    ESP_LOGI(TAG,"GOBOT_HOST_ADMISSION_RENDER known=%d allowed=%d code=%s mode=%s revision=%lu native_view=%u notice_rendered=%d render_result=%u evidence=native_framebuffer_only",
+        int(host_admission_ui_.Known()),int(host_admission_ui_.InputAllowed()),host_admission_ui_.CodeName(),
+        host_admission_ui_.ModeName(),(unsigned long)host_admission_ui_.Revision(),unsigned(native_view),
+        int(host_admission_ui_.RenderedNotice()),unsigned(result));
+    HostControl("gobot_host_ack",std::string(",\"event\":\"admission_rendered\",\"admission_known\":true,\"input_allowed\":")+
+        (host_admission_ui_.InputAllowed()?"true":"false")+",\"code\":\""+host_admission_ui_.CodeName()+
+        "\",\"mode\":\""+host_admission_ui_.ModeName()+"\",\"notice_rendered\":"+
+        (host_admission_ui_.RenderedNotice()?"true":"false")+",\"render_revision\":"+
+        std::to_string(host_admission_ui_.Revision())+",\"render_evidence\":\""+
+        host_admission_ui_.RenderEvidence()+"\"");
+}
