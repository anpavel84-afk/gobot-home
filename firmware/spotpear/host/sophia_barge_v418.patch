+// Fence local playback before requesting either remote cancellation barrier.
+// Keep current owner IDs: already-in-flight output_start/cancel must still match.
+bool Application::HostBeginInterrupt(const std::string& id,bool listen) {
+    if(!host_mode_ || !host_ready_ || host_muted_ ||
+       !host_interrupt_.Begin(id.c_str(),gobot::NowMs(),listen))return false;
+    audio_service_.AllowHostWake(false);
+    host_interrupt_quiet_sent_=false;
+    host_whole_response_=host_output_end_=false;
+    host_output_receipts_.Reset();audio_service_.ResetDecoder();
+    host_touch_active_=listen;host_voice_seen_=false;host_response_busy_=false;
+    host_touch_started_ms_=gobot::NowMs();host_feedback_.clear();
+    gobot_ui_phase_=listen?"listening":"";
+    ESP_LOGI(TAG,"SOPHIA_INTERRUPT_LOCAL event_id=%s listen=%d output_active=%d output_epoch=%lu sample_floor=%llu",
+        id.c_str(),int(listen),int(host_output_active_.load()),(unsigned long)host_output_epoch_,
+        (unsigned long long)audio_service_.HostCaptureSampleEnd());
+    return true;
+}
