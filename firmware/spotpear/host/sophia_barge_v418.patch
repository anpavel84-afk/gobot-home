diff --git a/main/host_barge_wake.h b/main/host_barge_wake.h
new file mode 100644
--- /dev/null
+++ b/main/host_barge_wake.h
@@ -0,0 +1,115 @@
+#pragma once
+// One input task, one existing WakeNet. AEC only prepares the active-output
+// wake input; idle wake and raw host capture never pass through this adapter.
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+#include "esp_aec.h"
+#include "esp_heap_caps.h"
+
+namespace gobot_host {
+class PlaybackReferenceAec {
+public:
+    static constexpr size_t kChunk=512;
+    PlaybackReferenceAec()=default;
+    PlaybackReferenceAec(const PlaybackReferenceAec&)=delete;
+    PlaybackReferenceAec& operator=(const PlaybackReferenceAec&)=delete;
+    ~PlaybackReferenceAec(){Close();}
+
+    bool Initialize(bool reference,unsigned channels) {
+        if(attempted_)return Ready();
+        attempted_=true;
+        if(!reference || channels!=2)return false;
+        aec_config_t config{};
+        config.mic_num=1;config.ref_num=1;config.out_num=1;
+        config.filter_length=4;config.sample_rate=16000;
+        config.caps=MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT;
+        config.mode=AEC_MODE_FD_LOW_COST;config.nlp_level=AEC_NLP_LEVEL_AGGR;
+        handle_=aec_create_from_config(&config);
+        if(!handle_ || aec_get_chunksize(handle_)!=int(kChunk)){Close();return false;}
+        const auto caps=MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT;
+        mic_=static_cast<int16_t*>(heap_caps_aligned_alloc(16,kChunk*sizeof(int16_t),caps));
+        ref_=static_cast<int16_t*>(heap_caps_aligned_alloc(16,kChunk*sizeof(int16_t),caps));
+        clean_=static_cast<int16_t*>(heap_caps_aligned_alloc(16,kChunk*sizeof(int16_t),caps));
+        if(!mic_ || !ref_ || !clean_){Close();return false;}
+        return true;
+    }
+    bool Ready()const{return handle_ && mic_ && ref_ && clean_;}
+    void Reset(){fill_=0;has_clock_=false;frame_has_reference_=false;}
+
+    // start is the original hardware capture position. No wall-clock/processing
+    // delay is added to it. Blocks are <=160 samples, so at most one 512-sample
+    // AEC output is produced; any input after that output stays in the next frame.
+    bool Feed(uint32_t epoch,uint64_t start,const int16_t* stereo,size_t samples,
+              uint64_t& clean_start,const int16_t*& clean) {
+        clean=nullptr;clean_start=0;
+        if(!Ready() || !epoch || !stereo || !samples || samples>160)return false;
+        if(!has_clock_ || epoch!=epoch_ || start!=next_sample_) {
+            fill_=0;frame_has_reference_=false;epoch_=epoch;next_sample_=start;has_clock_=true;
+        }
+        for(size_t i=0;i<samples;++i) {
+            if(!fill_)frame_start_=next_sample_;
+            mic_[fill_]=stereo[2*i];ref_[fill_]=stereo[2*i+1];
+            if(ref_[fill_])frame_has_reference_=true;
+            ++fill_;++next_sample_;
+            if(fill_==kChunk) {
+                aec_process(handle_,mic_,ref_,clean_);
+                ++frames_;if(frame_has_reference_)++reference_frames_;
+                clean_start=frame_start_;clean=clean_;
+                fill_=0;frame_has_reference_=false;
+            }
+        }
+        return true;
+    }
+    uint64_t Frames()const{return frames_;}
+    uint64_t ReferenceFrames()const{return reference_frames_;}
+private:
+    void Close() {
+        if(handle_)aec_destroy(handle_);
+        handle_=nullptr;
+        for(auto* p:{mic_,ref_,clean_})if(p)heap_caps_free(p);
+        mic_=ref_=clean_=nullptr;Reset();
+    }
+    aec_handle_t* handle_=nullptr;
+    int16_t *mic_=nullptr,*ref_=nullptr,*clean_=nullptr;
+    bool attempted_=false,has_clock_=false,frame_has_reference_=false;
+    size_t fill_=0;
+    uint32_t epoch_=0;
+    uint64_t next_sample_=0,frame_start_=0,frames_=0,reference_frames_=0;
+};
+
+// Only a correlated, current gateway completion releases local audio fencing.
+// Ordinary/late state messages cannot revive the interrupted answer.
+class InterruptLatch {
+public:
+    bool Begin(const char* id,uint64_t now,bool listen) {
+        if(Pending() || !ValidId(id))return false;
+        std::strcpy(id_,id);started_=now;listen_=listen;return true;
+    }
+    bool Complete(const char* id,const char* outcome) {
+        if(!Pending() || !id || std::strcmp(id_,id) || !outcome ||
+           (std::strcmp(outcome,"listening") && std::strcmp(outcome,"ready")))return false;
+        Reset();return true;
+    }
+    bool Pending()const{return id_[0]!=0;}
+    bool Listen()const{return listen_;}
+    bool Expired(uint64_t now)const{return Pending() && now>=started_ && now-started_>=8000;}
+    const char* Id()const{return id_;}
+    void Reset(){id_[0]=0;started_=0;listen_=false;}
+private:
+    static bool ValidId(const char* id) {
+        if(!id)return false;
+        size_t n=0;
+        for(;id[n];++n) {
+            if(n>=80)return false;
+            const char c=id[n];
+            if(!((c>='a'&&c<='z') || (c>='A'&&c<='Z') || (c>='0'&&c<='9') || c=='-' || c=='_'))return false;
+        }
+        return n!=0;
+    }
+    char id_[81]{};
+    uint64_t started_=0;
+    bool listen_=false;
+};
+} // namespace gobot_host
