@@ -0,0 +1,43 @@
+#pragma once
+// Negotiated HOST v2 uses the unchanged V4 mono 16 kHz, pre-AFE microphone
+// samples. One audio-input task owns this packer; no network or I2S calls.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace gobot_host {
+struct CapturePosition {
+    uint32_t epoch = 0;
+    uint64_t frame_id = 0;
+    uint64_t sample_start = 0;
+    uint32_t sample_count = 0;
+};
+
+class CapturePacker {
+public:
+    static constexpr size_t kSamples = 960;
+    void Reset(uint32_t epoch) {
+        epoch_ = epoch; next_ = frame_ = fill_ = 0;
+        std::fill(pcm_, pcm_ + kSamples, 0);
+    }
+    uint32_t Epoch() const { return epoch_; }
+    uint64_t NextSample() const { return next_; }
+    template<class Consumer>
+    bool Feed(const int16_t* pcm, size_t count, Consumer&& emit) {
+        if (!epoch_ || !pcm || !count || count > kSamples) return false;
+        for (size_t i = 0; i < count; ++i) {
+            pcm_[fill_++] = pcm[i]; ++next_;
+            if (fill_ == kSamples) {
+                emit(CapturePosition{epoch_, frame_++, next_ - kSamples, kSamples}, pcm_);
+                std::fill(pcm_, pcm_ + kSamples, 0); fill_ = 0;
+            }
+        }
+        return true;
+    }
+private:
+    int16_t pcm_[kSamples]{};
+    uint32_t epoch_ = 0;
+    uint64_t next_ = 0, frame_ = 0;
+    size_t fill_ = 0;
+};
+} // namespace gobot_host
