+void AudioService::EnableHostCapture(bool enabled) {
+    host_capture_enabled_.store(false);
+    host_wake_allowed_.store(false);
+    host_capture_epoch_.fetch_add(1);
+    host_capture_sample_end_.store(0);
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        for (auto& q : {&audio_send_queue_}) {
+            while (!q->empty()) {
+                auto frame = std::move(q->front()); q->pop_front();
+                std::fill(frame->payload.begin(), frame->payload.end(), 0);
+            }
+        }
+        while (!audio_encode_queue_.empty()) {
+            auto frame = std::move(audio_encode_queue_.front()); audio_encode_queue_.pop_front();
+            std::fill(frame.pcm.begin(), frame.pcm.end(), 0);
+        }
+        audio_queue_cv_.notify_all();
+    }
+    local_hold_.store(false);
+    sophia_wake_pending_.store(false);
+    sophia_buffer_handoff_.store(false);
+    host_capture_enabled_.store(enabled);
+    host_wake_allowed_.store(enabled);
+    if (enabled) SetLocalScan(true);
+}
+
