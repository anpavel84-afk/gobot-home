+#pragma once
+// Bounded digital playback ledger. Segment receipts require actual I2S DMA
+// events to cover the packet containing the segment's final 24 kHz sample.
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <utility>
+namespace gobot_host {
+inline bool wire_identifier(const std::string& value, bool segment=false) {
+    if (value.empty() || value.size() > (segment ? 96u : 64u)) return false;
+    for (unsigned char c : value)
+        if (!((c>='a'&&c<='z') || (c>='A'&&c<='Z') || (c>='0'&&c<='9') ||
+              c=='-' || c=='_' || (segment && c==':'))) return false;
+    return true;
+}
+struct SegmentFence {
+    std::string id;
+    uint64_t sample_end=0;
+    uint32_t dma_fence=0;
+    bool armed=false;
+};
+class OutputReceipts {
+    std::deque<SegmentFence> pending_;
+    uint64_t written_samples_=0, last_segment_end_=0;
+    uint32_t last_dma_fence_=0;
+public:
+    void Reset() { pending_.clear(); written_samples_=last_segment_end_=0; last_dma_fence_=0; }
+    bool Segment(const std::string& id,uint64_t end) {
+        if (!wire_identifier(id,true) || !end || end<=last_segment_end_ ||
+            end>6001ULL*1440 || pending_.size()>=16) return false;
+        last_segment_end_=end;
+        SegmentFence segment{id,end,last_dma_fence_,end<=written_samples_};
+        pending_.push_back(std::move(segment)); return true;
+    }
+    bool Written(uint32_t packet,uint32_t fence) {
+        const uint64_t end=(uint64_t(packet)+1)*1440;
+        if (end!=written_samples_+1440) return false;
+        written_samples_=end; last_dma_fence_=fence;
+        for (auto& segment:pending_)
+            if (!segment.armed && segment.sample_end<=end) {
+                segment.dma_fence=fence; segment.armed=true;
+            }
+        return true;
+    }
+    template<class Reached, class Receipt>
+    void Poll(Reached&& reached,Receipt&& receipt) {
+        while (!pending_.empty() && pending_.front().armed && reached(pending_.front().dma_fence)) {
+            auto segment=std::move(pending_.front());pending_.pop_front();receipt(segment);
+        }
+    }
+    bool Empty() const { return pending_.empty(); }
+};
