+void Application::HostSetMuted(bool muted,bool notify) {
+    if(host_muted_==muted)return;
+    if(notify)HostControl("gobot_host_mute",std::string(",\"muted\":")+(muted?"true":"false"));
+    else HostControl("gobot_host_ack",std::string(",\"event\":\"muted\",\"muted\":")+(muted?"true":"false"));
+    host_muted_=gobot_muted_=muted;
+    audio_service_.EnableHostCapture(false);audio_service_.SetLocalScan(false);
+    audio_service_.EnableVoiceProcessing(false);audio_service_.ResetDecoder();
+    host_touch_active_=host_response_busy_=false;host_output_receipts_.Reset();
+    if(!muted) {
+        // A new authenticated transport/capture epoch prevents old PCM or a
+        // hidden sample discontinuity from crossing mute/unmute.
+        host_ready_=false;host_output_active_=host_output_started_=host_output_end_=false;
+        host_playback_id_.clear();host_response_id_.clear();host_stop_id_.clear();
+        if(host_connecting_.load())host_connect_abort_reason_="mute_changed";
+        else protocol_->CloseAudioChannel();
+        host_ready_deadline_ms_=0;host_next_retry_ms_=gobot::NowMs();audio_service_.SetLocalScan(true);
+    }
+    RenderGoBot();
+}
+
+void Application::HostColdWake() {
+    if(host_probe_wake_pending_)return;
+    host_probe_wake_pending_=true;host_touch_active_=true;gobot_ui_phase_="listening";
+    const uint64_t callback=host_local_wake_callback_us_.load();
+    gobot_host::OnNextNativeRefresh([this,callback](){
+        const uint64_t visible=esp_timer_get_time();
+        Schedule([callback,visible](){
+            ESP_LOGI(TAG,"SOPHIA_COLD_UI_VISIBLE callback_us=%llu visible_us=%llu delta_us=%llu",
+                (unsigned long long)callback,(unsigned long long)visible,
+                (unsigned long long)(visible>=callback?visible-callback:0));
+        });
+    });
+    // Keep the installed V4's question buffer, local_hold and detector handoff.
+    // No network operation or capture reset occurs on this UI reaction path.
+    RenderGoBot();
+}
+
+void Application::HostBeginConnect() {
+    if(host_connecting_.exchange(true))return;
+    host_connect_abort_reason_.clear();host_deferred_ready_.clear();
+    // One temporary bounded worker, one existing protocol/socket. Input,
+    // display and touch tasks remain runnable during DNS/TLS/server hello.
+    const auto rc=xTaskCreate([](void* argument){
+        auto* app=static_cast<Application*>(argument);
+        const bool connected=app->protocol_ && app->protocol_->OpenAudioChannel();
+        app->Schedule([app,connected](){app->HostConnectDone(connected);});
+        vTaskDelete(nullptr);
+    },"sophia_connect",8192,this,1,nullptr);
+    if(rc!=pdPASS) {
+        host_connecting_=false;HostFault("connect_task_allocation_failed");
+    }
+}
+
+void Application::HostConnectDone(bool connected) {
+    host_connecting_=false;
+    auto* ws=static_cast<WebsocketProtocol*>(protocol_.get());
+    if(!ws)return;
+    // A wake event may have been posted in the same main-task dispatch batch.
+    if(host_unified_ && !host_muted_ && !gobot_muted_ &&
+       audio_service_.LocalWakePending())HostColdWake();
+    const bool wake=host_probe_wake_pending_;
+    const auto aborted=host_connect_abort_reason_;
+    host_connect_abort_reason_.clear();
+    if(wake && connected && aborted.empty() && !host_muted_ && !gobot_muted_) {
+        // The user began speaking while the idle capability probe was running.
+        // Preserve V4's exact local prefix/question handoff for this first turn;
+        // negotiate unified mode again only after that turn has completed.
+        host_mode_=host_ready_=host_unified_=host_touch_active_=false;
+        host_probe_wake_pending_=false;host_deferred_ready_.clear();
+        ws->CloseAudioChannel();ws->ConfigureHostTest("");
+        host_auto_retry_ms_=gobot::NowMs()+60000;
+        if(audio_service_.ConsumeSophiaWakeOverflow()) {
+            audio_service_.ClearLocalWake();notice_="Связь задержалась. Повторите вопрос";
+            notice_until_=gobot::NowMs()+3500;RenderGoBot();
+        } else StartGoBotTurn("wake");
+        return;
+    }
+    if(!connected || !aborted.empty() || host_muted_ || gobot_muted_) {
+        HostFault(aborted.empty()?"gateway_connect_failed":aborted.c_str());return;
+    }
+    host_ready_deadline_ms_=gobot::NowMs()+2500;
+    if(!host_deferred_ready_.empty()) {
+        const auto ready=std::move(host_deferred_ready_);host_deferred_ready_.clear();
+        auto message=cJSON_Parse(ready.c_str());
+        if(message){HostOnControl(message);cJSON_Delete(message);}
+        else HostFault("invalid_deferred_ready");
+    }
+    RenderGoBot();
 }
 
