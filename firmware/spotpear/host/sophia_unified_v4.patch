 void AudioCodec::OutputData(std::vector<int16_t>& data) {
-    Write(data.data(), data.size());
+    tx_write_ok_.store(Write(data.data(), data.size()) == static_cast<int>(data.size()));
+    if (tx_receipts_ready_) {
+        // Once a complete DMA ring plus one descriptor has actually been sent
+        // after the final write, no sample from that write remains in I2S DMA.
+        // This proves digital playback completion, not acoustic onset.
+        tx_tail_target_.store(tx_sent_count_.load() + AUDIO_CODEC_DMA_DESC_NUM + 1);
+    }
+}
+
+bool IRAM_ATTR AudioCodec::OnDmaSent(i2s_chan_handle_t, i2s_event_data_t*, void* context) {
+    static_cast<AudioCodec*>(context)->tx_sent_count_.fetch_add(1, std::memory_order_relaxed);
+    return false;
+}
+
+void AudioCodec::RegisterOutputDrainReceipt() {
+    i2s_event_callbacks_t callbacks{};
+    callbacks.on_sent = &AudioCodec::OnDmaSent;
+    const auto rc = i2s_channel_register_event_callback(tx_handle_, &callbacks, this);
+    tx_receipts_ready_ = rc == ESP_OK;
+    ESP_LOGI(TAG, "HOST_TX_DMA_RECEIPT ready=%d descriptors=%u frames=%u", tx_receipts_ready_,
+             AUDIO_CODEC_DMA_DESC_NUM, AUDIO_CODEC_DMA_FRAME_NUM);
+}
+
+bool AudioCodec::HardwareOutputDrained() const {
+    return HardwareFenceReached(tx_tail_target_.load());
+}
+
+bool AudioCodec::HardwareFenceReached(uint32_t fence) const {
+    return tx_receipts_ready_ && tx_write_ok_.load() &&
+        static_cast<int32_t>(tx_sent_count_.load() - fence) >= 0;
 }
 
