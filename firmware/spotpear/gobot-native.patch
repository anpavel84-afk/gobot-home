+void Application::GoBotPoll() {
+    switch(gobot_turn_.Poll(gobot::NowMs(),audio_service_.IsVoiceDetected(),audio_service_.IsPlaybackIdle())) {
+    case gobot::Action::StopCapture:
+        audio_service_.EnableVoiceProcessing(false);
+        while(audio_service_.PopPacketFromSendQueue()) {}
+        if(protocol_)protocol_->SendStopListening();
+        Board::GetInstance().GetDisplay()->SetStatus("Думаю...");
+        ESP_LOGI(TAG,"GOBOT_UTTERANCE_END upload=0");break;
+    case gobot::Action::Finish:GoBotFinish("turn_complete");break;
+    case gobot::Action::Timeout:GoBotFinish("timeout");break;
+    default:break;
+    }
+}
+void Application::GoBotSerial(const std::string& line) {
+    if(line.rfind("GOBOT_CFG ",0)==0) {
+        if(gobot_turn_.Active()) {ESP_LOGW(TAG,"GOBOT_CONFIG_BUSY");return;}
+        const bool ok=gobot::SaveEnrollment(line.substr(10));
+        ESP_LOGI(TAG,"GOBOT_CONFIG_%s",ok?"OK":"FAILED");
+    } else if(line=="GOBOT_STATUS") {
+        gobot::Enrollment e;
+        const auto words=audio_service_.GetWakeWords();
+        ESP_LOGI(TAG,"GOBOT_STATUS version=%s wifi=%d enrolled=%d muted=%d phase=%d wake_running=%d wake_words=%u upload=%d",
+                 GOBOT_FIRMWARE_VERSION,gobot_network_ready_,gobot::LoadEnrollment(e),gobot_muted_,
+                 static_cast<int>(gobot_turn_.GetPhase()),audio_service_.IsWakeWordRunning(),
+                 static_cast<unsigned>(words.size()),gobot_turn_.UploadAllowed());
+    } else if(line=="GOBOT_MUTE") {
+        gobot_muted_=true;GoBotFinish("muted");
+    } else if(line=="GOBOT_UNMUTE") {
+        gobot_muted_=false;GoBotFinish("unmuted");
+    }
+}
