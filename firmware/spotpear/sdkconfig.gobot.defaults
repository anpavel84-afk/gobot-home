# GoBot bring-up: only local custom GoBot phonetic detector. Never enable generic wake words.
CONFIG_BOARD_TYPE_SPOTPEAR_ESP32_S3_1_28_BOX=y
CONFIG_LANGUAGE_RU_RU=y
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="go bot"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="ГоБот"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=70
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_USE_DEVICE_AEC=n
CONFIG_USE_SERVER_AEC=n
CONFIG_RECEIVE_CUSTOM_MESSAGE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="gobot_ca.pem"
CONFIG_USE_AUDIO_DEBUGGER=n
CONFIG_GOBOT_DEVICE=y
