GOBOT_MODE=mock
GOBOT_DB=data/gobot.sqlite
GOBOT_BRAIN_PORT=18781
GOBOT_BRIDGE_PORT=18782
GOBOT_VOICE_PORT=18783
GOBOT_HTTP_PORT=18784
GOBOT_FAST_PROVIDER=mock
GOBOT_ASR=mock
GOBOT_TTS=mock
# These ASR/TTS settings describe the legacy XiaoZhi diagnostic overlay.
# Browser speech defaults: OpenAI STT (file/live), OpenAI Realtime / marin TTS.
# Local Whisper Small is manual only. No automatic STT/TTS fallback.
# Store the OpenAI voice key through private HTTPS /settings/openai (Windows DPAPI).
# Denis is an explicit offline choice, never automatic fallback.
GOBOT_VAD=mock
GOBOT_API_BASE=https://api.openai.com/v1
GOBOT_API_MODEL=
GOBOT_API_KEY=
GOBOT_ALLOW_PAID=0
# Secrets are generated in ignored run/keys.json; never paste existing CLI tokens.
